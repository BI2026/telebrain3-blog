---
import { getCollection } from 'astro:content';
import { CHAPTERS, normalizeChapter } from '../lib/chapters';

const all = await getCollection('posts');
const posts = [...all].sort((a, b) => b.data.created.getTime() - a.data.created.getTime());

// 챕터별 글 수 (정규화 후)
const countsByChapter: Record<string, number> = {};
for (const p of all) {
  const c = normalizeChapter(p.data.chapter).id;
  countsByChapter[c] = (countsByChapter[c] || 0) + 1;
}
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>불, 강철, 배터리 — 에너지의 방향을 현실로 바꾼 소재의 12,000년</title>
    <meta name="description" content="에너지는 문명의 방향을 바꾸지만, 그 방향을 현실로 만드는 것은 소재다. 불·청동·철·석탄·석유·전기·배터리·피지컬 AI — 9개 시대를 가로지르는 소재의 문명사." />
    <link rel="alternate" type="application/rss+xml" title="불, 강철, 배터리" href="/rss.xml" />
    <style is:global>
      :root {
        --fg: #1a1a1a; --fg-soft: #333; --muted: #6b6b6b;
        --accent: #b14430; --accent-soft: #f4ebe6;
        --bg: #fbf9f6; --line: #e3ddd5;
      }
      body { font-family: "Pretendard Variable", "Apple SD Gothic Neo", "Noto Sans KR", -apple-system, sans-serif;
             max-width: 760px; margin: 0 auto; padding: 2.5rem 1.2rem 4rem;
             line-height: 1.85; color: var(--fg); background: var(--bg);
             font-size: 17px; word-break: keep-all; }
      a { color: var(--accent); text-decoration: none; border-bottom: 1px dotted var(--accent); }
      a:hover { background: var(--accent-soft); }

      h1 { font-size: 1.85rem; line-height: 1.3; margin: 0 0 0.5rem; letter-spacing: -0.01em; }
      h1 .sub { display: block; font-size: 1rem; font-weight: 500; color: var(--muted); margin-top: 0.5rem; line-height: 1.5; letter-spacing: 0; }
      .thesis {
        color: var(--fg-soft); font-size: 1rem;
        border-left: 3px solid var(--accent); padding: 0.6rem 1.2rem;
        margin: 1.5rem 0 2.5rem; background: var(--accent-soft); border-radius: 0 4px 4px 0;
      }
      .thesis em { font-style: normal; color: var(--accent); font-weight: 600; }

      h2 { font-size: 1.1rem; color: var(--muted); margin-top: 2.5rem; font-weight: 600;
           border-top: 1px solid var(--line); padding-top: 1.2rem; }

      ul.posts { list-style: none; padding: 0; }
      ul.posts li { margin-bottom: 1.4rem; padding-bottom: 1rem; border-bottom: 1px dashed var(--line); }
      ul.posts li:last-child { border-bottom: none; }
      ul.posts a.title { font-size: 1.05rem; font-weight: 600; }
      .meta { font-size: 0.82rem; color: var(--muted); margin-top: 0.3rem; }
      .meta a { color: var(--muted); border: none; }
      .meta a:hover { color: var(--accent); background: none; text-decoration: underline; }

      .chapter-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.8rem; margin-top: 1rem; }
      .chapter-card {
        padding: 0.8rem 1rem; background: white; border: 1px solid var(--line);
        border-radius: 6px; transition: all 0.15s;
      }
      .chapter-card:hover { border-color: var(--accent); transform: translateY(-1px); }
      .chapter-card a { border: none; }
      .chapter-card .name { font-weight: 600; color: var(--fg); display: block; }
      .chapter-card .story { font-size: 0.82rem; color: var(--muted); margin-top: 0.3rem; line-height: 1.5; }
      .chapter-card .count { font-size: 0.78rem; color: var(--accent); margin-top: 0.4rem; }

      @media (max-width: 600px) { body { font-size: 16px; } h1 { font-size: 1.55rem; } }
    </style>
  </head>
  <body>
    <h1>
      불, 강철, 배터리
      <span class="sub">에너지의 방향을 현실로 바꾼 소재의 12,000년 — 그리고 한국이 만든 마지막 장</span>
    </h1>

    <p class="thesis">
      <em>에너지는 문명의 방향을 바꾸지만, 그 방향을 현실로 만드는 것은 소재다.</em><br />
      불은 금속을 만나 도구가 됐고, 석탄은 강철을 만나 산업이 됐다. 석유는 고무·플라스틱을 만나 이동의 문명이 됐고, 전기는 텅스텐과 실리콘을 만나 빛과 정보의 세계로 확장됐다. 모든 글은 어딘가에서 이 명제를 가시화한다.
    </p>

    <h2>최근 atomic note</h2>
    <ul class="posts">
      {posts.slice(0, 12).map((post) => {
        const ch = normalizeChapter(post.data.chapter);
        return (
          <li>
            <a class="title" href={`/posts/${post.slug}/`}>
              {post.data.title || post.slug}
            </a>
            <div class="meta">
              {post.data.created.toISOString().slice(0, 10)} ·
              <a href={`/chapters/${ch.id}/`}>{ch.short}</a>
              {post.data.material && ` · 소재 ${post.data.material}`}
            </div>
          </li>
        );
      })}
    </ul>

    <h2>9개 시대로 보는 책의 척추</h2>
    <div class="chapter-grid">
      {CHAPTERS.map((c) => (
        <div class="chapter-card">
          <a href={`/chapters/${c.id}/`}>
            <span class="name">{c.label}</span>
            <span class="story">{c.story}</span>
            <span class="count">누적 {countsByChapter[c.id] || 0}편</span>
          </a>
        </div>
      ))}
    </div>
  </body>
</html>
